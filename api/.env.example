# Paid GPU is intentionally OFF by default.
ENABLE_PAID_GPU=false

# Fill these only when we are ready to connect the backend to RunPod.
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=

# Independent server-side approval gate. Keep empty until a paid test is explicitly approved.
# Never expose this value in browser JavaScript.
COST_APPROVAL_SECRET=

# Paid submissions fail closed unless the video host is explicitly allowed.
# Production should use our own object storage with short-lived signed URLs.
# Example: scout-videos.example-storage.com
VIDEO_HOST_ALLOWLIST=

# Current selected GPU price in the RunPod UI. Update if worker configuration changes.
GPU_PRICE_PER_HOUR=0.58

# Leave empty until a short paid benchmark has measured the real processing time.
# Example meaning: if a 2-minute video consumes 36 GPU seconds, enter 18.
BENCHMARK_GPU_SECONDS_PER_VIDEO_MINUTE=

# Local durable stores for the single-host prototype. Put these on a persistent
# volume if the API container is restarted. Before horizontal scaling, replace
# both SQLite stores with shared transactional storage (for example Postgres).
JOB_DB_PATH=/tmp/football-scout-jobs.sqlite3
IDEMPOTENCY_DB_PATH=/tmp/football-scout-idempotency.sqlite3
